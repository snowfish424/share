# Copy to workshop.env and replace every example value before the class.
# Use bash on the Linux lab host. Never put a token or password in this file.
export PROJECT=cwa-user01
export REGISTRY=registry.example.invalid
export REGISTRY_NAMESPACE=training-user01
export ARCH=amd64
export BASE_IMAGE=registry.access.redhat.com/ubi9/python-312:latest
export IMAGE_REPO="$REGISTRY/$REGISTRY_NAMESPACE/cwa-weather"
export IMAGE_V1="$IMAGE_REPO:1.0"
export IMAGE_V2="$IMAGE_REPO:2.0"
