# 由講師填妥後，以 quickstart.env 名稱交給對應學員。
# 本檔只放非敏感環境參數；Token 另行配發，不寫入檔案。
# 學員會在 workshop/ 目錄執行 source quickstart.env。
export PROJECT=cwa-user01
export REGISTRY=quay.io
export REGISTRY_USER=YOUR_QUAY_USERNAME
export ARCH=amd64
export BASE_IMAGE=registry.access.redhat.com/ubi9/python-312:latest
export PUSH_IMAGE=quay.io/cwa/ocp/cwa-weather:1.0
export DEPLOY_IMAGE="$PUSH_IMAGE"
