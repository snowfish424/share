apiVersion: v1
kind: ConfigMap
metadata:
  name: custom-mig-config
  namespace: nvidia-gpu-operator
data:
  config.yaml: |
    version: v1
    mig-configs:
      all-disabled:
        - devices: all
          mig-enabled: false
      h200-mig-custom:
        # Device 1：切分成 7 個 1g.18gb 分片
        - devices: [1]
          mig-enabled: true
          mig-devices:
            "1g.18gb": 7    
        # Device 2：切分成 3 個 2g.35gb 分片
        - devices: [2]
          mig-enabled: true
          mig-devices:
            "2g.35gb": 3
        # Device 4：切分成 2 個 3g.71gb 分片
        - devices: [4]
          mig-enabled: true
          mig-devices:
            "3g.71gb": 2    

# 1. 在 nvidia-gpu-operator 命名空間建立 ConfigMap
oc create configmap custom-mig-config \
  --from-file=config.yaml=custom-mig-config.yaml \
  -n nvidia-gpu-operator

# 2. 修改 ClusterPolicy 將策略設為 mixed 並載入 ConfigMap
oc patch clusterpolicy cluster-policy --type=merge -p '{
  "spec": {
    "mig": {
      "strategy": "mixed",
      "config": {
        "name": "custom-mig-config"
      }
    }
  }
}'

oc label node <h200-node-name> nvidia.com/mig.config=h200-mig-custom --overwrite

