HOST="<was-host>"
PORT="9080"
URL="http://${HOST}:${PORT}/metrics"
OUT="was-metrics-$(date +%Y%m%d-%H%M%S).txt"

curl -sS -o "$OUT" -w "http_code=%{http_code} size=%{size_download} time=%{time_total}s\n" "$URL" \
  | tee was-metrics-summary.txt

{
  echo "=== basic ==="
  echo "file: $OUT"
  echo "lines: $(wc -l < "$OUT")"
  echo "bytes: $(wc -c < "$OUT")"
  echo
  echo "=== metric names (unique) ==="
  grep -v '^#' "$OUT" | awk '{print $1}' | sed 's/{.*//' | sort -u | wc -l
  echo
  echo "=== top metric prefixes ==="
  grep -v '^#' "$OUT" | awk '{print $1}' | sed 's/{.*//' | \
    awk -F_ '{print $1"_"$2}' | sort | uniq -c | sort -nr | head -20
  echo
  echo "=== was_* series estimate ==="
  grep -v '^#' "$OUT" | grep -c '^was_'
  echo
  echo "=== top was_* metric names ==="
  grep -v '^#' "$OUT" | grep '^was_' | awk '{print $1}' | sed 's/{.*//' | \
    sort | uniq -c | sort -nr | head -20
} >> was-metrics-summary.txt

cat was-metrics-summary.txt

curl -sS "http://10.97.36.52:80/metrics?target=10.95.36.103:9089" \
  | grep -a '^was_connectionpool_' \
  | sed -n 's/.*jndiname="\([^"]*\)".*/\1/p' \
  | sort -u | head -20

- job_name: ibm-was-pmi-103
  scrape_interval: 60s
  scrape_timeout: 55s
  sample_limit: 80000
  static_configs:
    - targets: ['10.97.36.52:80']
  metrics_path: /metrics
  params:
    target: ['10.95.36.103:9089']
  relabel_configs:
    - source_labels: [__param_target]
      target_label: instance
  metric_relabel_configs:
    - source_labels: [__name__, jndiname]
      regex: 'was_(servlet|threadpool|session|ejb|sib|authentication|authorization|transactionmanager|odr|scrape)_.*;|base_.*;|vendor_.*;|process_.*;|system_.*;|jvm_.*;|was_connectionpool_.*;(jdbc/auth|jdbc/B2CDBOC|jdbc/bpmlog)$'
      action: keep
